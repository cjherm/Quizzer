# Gradle and build output
.gradle/
.kotlin/
build/
captures/
.cxx/

# Machine-specific settings
local.properties
.idea/
*.iml

# Build artifacts
*.apk
*.aab
*.class
*.jar
# The Gradle wrapper jar must be committed (the *.jar rule above would exclude it)
!gradle/wrapper/gradle-wrapper.jar

# Signing keys: never commit these
*.jks
*.keystore

# Logs and crash dumps
*.log
hs_err_pid*
replay_pid*

# Archives (e.g. design exports; unpack what's needed into docs/)
*.zip
*.tar.gz
*.rar

# OS files
.DS_Store
Thumbs.db

# Design reference screenshots (kept locally, too large for the repo)
docs/design/**/screens/
